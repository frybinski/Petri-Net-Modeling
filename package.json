{
  "name": "petri-net-modeling",
  "version": "1.3.0",
  "private": true,
  "description": "Web-based modeling tool for higher Petri nets",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @pnm/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "test:e2e": "pnpm --filter @pnm/web test:e2e",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
