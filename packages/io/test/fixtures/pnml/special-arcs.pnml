<?xml version="1.0" encoding="UTF-8"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="n" type="http://www.yasper.org/specs/epnml-1.1">
    <name><text>Special arcs</text></name>
    <page id="pg">
      <place id="p1"><name><text>Queue</text></name><graphics><position x="50" y="50"/></graphics><initialMarking><text>Default,2</text></initialMarking></place>
      <place id="p2"><name><text>Lock</text></name><graphics><position x="50" y="200"/></graphics></place>
      <place id="p3"><name><text>Out</text></name><graphics><position x="350" y="50"/></graphics></place>
      <transition id="t1"><name><text>Go</text></name><graphics><position x="200" y="50"/></graphics></transition>
      <arc id="a1" source="p1" target="t1"/>
      <arc id="a2" source="p2" target="t1"><type value="inhibitor"/></arc>
      <arc id="a3" source="t1" target="p3"><inscription><text>2.5</text></inscription></arc>
      <arc id="a4" source="t1" target="p2" type="reset"/>
      <arc id="a5" source="t1" target="ghost"/>
    </page>
  </net>
</pnml>
