<?xml version="1.0" encoding="UTF-8"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="net" type="http://www.pnml.org/version-2009/grammar/ptnet">
    <name><text>Two pages</text></name>
    <page id="front">
      <place id="p1">
        <name><text>Ready</text></name>
        <graphics><position x="0" y="0"/></graphics>
        <initialMarking><text>2</text></initialMarking>
      </place>
      <transition id="t1">
        <name><text>Hand over</text></name>
        <graphics><position x="100" y="0"/></graphics>
      </transition>
      <referencePlace id="handover" ref="p2">
        <graphics><position x="200" y="0"/></graphics>
      </referencePlace>
      <arc id="a1" source="p1" target="t1"/>
      <arc id="a2" source="t1" target="handover"/>
    </page>
    <page id="back">
      <place id="p2">
        <name><text>Received</text></name>
        <graphics><position x="0" y="0"/></graphics>
      </place>
      <transition id="t2">
        <name><text>Process</text></name>
        <graphics><position x="100" y="0"/></graphics>
      </transition>
      <place id="p3">
        <name><text>Finished</text></name>
        <graphics><position x="200" y="0"/></graphics>
      </place>
      <arc id="a3" source="p2" target="t2"/>
      <arc id="a4" source="t2" target="p3"/>
    </page>
  </net>
</pnml>
