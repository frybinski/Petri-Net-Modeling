<?xml version="1.0" encoding="UTF-8"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
 <net id="reklamation" type="http://www.pnml.org/version-2009/grammar/ptnet">
  <name><text>Reklamation</text></name>
  <page id="page1">
   <place id="i"><name><text>Eingang</text></name><initialMarking><text>1</text></initialMarking></place>
   <place id="p1"><name><text>Ware offen</text></name></place>
   <place id="p2"><name><text>Historie offen</text></name></place>
   <place id="p3"><name><text>Ware geprüft</text></name></place>
   <place id="p4"><name><text>Historie geprüft</text></name></place>
   <place id="p5"><name><text>Entscheidbar</text></name></place>
   <place id="p6"><name><text>Entschieden</text></name></place>
   <place id="o"><name><text>Erledigt</text></name></place>
   <transition id="t1"><name><text>Reklamation erfassen</text></name></transition>
   <transition id="t2"><name><text>Ware prüfen</text></name></transition>
   <transition id="t3"><name><text>Historie prüfen</text></name></transition>
   <transition id="t4"><name><text>Entscheiden</text></name></transition>
   <transition id="t5"><name><text>Erstatten</text></name></transition>
   <transition id="t6"><name><text>Ablehnen</text></name></transition>
   <transition id="t7"><name><text>Kunde informieren</text></name></transition>
   <arc id="a1" source="i" target="t1"/><arc id="a2" source="t1" target="p1"/><arc id="a3" source="t1" target="p2"/>
   <arc id="a4" source="p1" target="t2"/><arc id="a5" source="p2" target="t3"/><arc id="a6" source="t2" target="p3"/>
   <arc id="a7" source="t3" target="p4"/><arc id="a8" source="p3" target="t4"/><arc id="a9" source="p4" target="t4"/>
   <arc id="a10" source="t4" target="p5"/><arc id="a11" source="p5" target="t5"/><arc id="a12" source="p5" target="t6"/>
   <arc id="a13" source="t5" target="p6"/><arc id="a14" source="t6" target="p6"/><arc id="a15" source="p6" target="t7"/>
   <arc id="a16" source="t7" target="o"/>
  </page>
 </net>
</pnml>
